{
  "name": "toolya",
  "version": "1.0.0",
  "description": "Eigenständige GitHub-Pages-Veröffentlichung für `toolya.app`.",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "node --test tests/amazon/*.test.mjs && node tests/platform/cloudonly-contract.cjs && node tests/platform/connect-panel.cjs && node tests/platform/connect-two-devices.cjs && npm run test:connect:browser",
    "dev": "node scripts/home-preview.cjs",
    "test:connect:browser": "node tests/platform/connect-playwright.cjs",
    "tools:scaffold": "node scripts/create-tool.cjs",
    "test:ai": "node --test tests/ai/*.test.cjs",
    "tools:preview": "node scripts/preview-tool.cjs",
    "tools:from-brief": "node scripts/create-tool-from-brief.cjs",
    "tools:build-briefs": "node scripts/build-tool-briefs.cjs",
    "i18n:check": "node scripts/i18n-quality.cjs --check",
    "i18n:report": "node scripts/i18n-quality.cjs --report",
    "test:i18n": "node --test tests/i18n/*.test.mjs",
    "productivity:list": "node scripts/productivity.cjs --list",
    "productivity:prompt": "node scripts/productivity.cjs",
    "productivity:check": "node scripts/productivity.cjs --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duhrrom11/toolya.git"
  },
  "keywords": [],
  "author": "",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/duhrrom11/toolya/issues"
  },
  "homepage": "https://github.com/duhrrom11/toolya#readme",
  "dependencies": {
    "linkedom": "0.18.12"
  },
  "private": true,
  "devDependencies": {
    "jsqr": "1.4.0",
    "playwright": "1.62.1"
  }
}
